<Window x:Class="SideDock.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SideDock" Width="510" Height="800" MinWidth="380" MinHeight="400" Background="#171C29" WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True" UseLayoutRounding="True">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="10" GlassFrameThickness="0"/></WindowChrome.WindowChrome>
 <Border BorderBrush="#363E52" BorderThickness="1" CornerRadius="10">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#111622" CornerRadius="10,0,0,10">
   <DockPanel Margin="7,12">
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="◧" Foreground="#A9B8FF" FontSize="27" HorizontalAlignment="Center" Margin="0,0,0,14" ToolTip="SideDock"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><Button Content="＋" FontSize="24" Click="Add_Click" ToolTip="添加网站 (Ctrl+T)"/><Button Content="◷" FontSize="22" Click="History_Click" ToolTip="浏览历史 (Ctrl+H)"/><Button Content="⚙" FontSize="20" Click="Settings_Click" ToolTip="设置"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PadRail"/></ScrollViewer>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="27"/></Grid.RowDefinitions>
   <Grid Margin="12,3,7,0" MouseLeftButtonDown="Title_Down">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="SIDEDOCK" FontSize="10" Foreground="#98A6C7" FontWeight="Bold"/><TextBlock x:Name="PageTitle" Text=" /  随手可及" Margin="8,0" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="185"/></StackPanel>
    <Button Grid.Column="1" x:Name="PinButton" Content="○" Click="Pin_Click" ToolTip="固定展开 / 自动收起"/>
    <Button Grid.Column="2" Content="→" Click="Hide_Click" ToolTip="收起 (Esc)"/>
   </Grid>
   <Grid Grid.Row="1" Margin="7,3,9,7">
    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
    <Button x:Name="BackButton" Content="‹" FontSize="22" Padding="3" Click="Back_Click" ToolTip="后退"/>
    <Button Grid.Column="1" Content="↻" FontSize="18" Padding="3" Click="Reload_Click" ToolTip="刷新 (Ctrl+R)"/>
    <TextBox Grid.Column="2" x:Name="Address" VerticalContentAlignment="Center" KeyDown="Address_KeyDown" ToolTip="输入网址或搜索内容 (Ctrl+L)"/>
    <Button Grid.Column="3" Content="↗" Padding="4" FontSize="19" Click="External_Click" ToolTip="在默认浏览器打开"/>
   </Grid>
   <Grid Grid.Row="2" x:Name="ContentHost" Background="White"/>
   <TextBlock Grid.Row="3" x:Name="Status" Text="Ctrl + Alt + Space 唤出 · 移到屏幕右缘展开" Foreground="#8996B4" FontSize="10" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
  </Grid>
 </Grid>
 </Border>
</Window>
